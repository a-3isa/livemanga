# Export these before running manage.py. Every value below is a placeholder.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me

# 1 for local development (also serves uploaded media); leave unset in production.
DJANGO_DEBUG=1

# Comma-separated host names the server answers to, e.g. add .ngrok.io for a tunnel.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
